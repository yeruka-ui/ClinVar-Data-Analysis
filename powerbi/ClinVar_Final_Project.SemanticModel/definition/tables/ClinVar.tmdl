	column SubmittersCapped
		dataType: int64
		formatString: 0
		lineageTag: 7944c1bd-5286-5df2-aa2f-b8fbcac08268
		summarizeBy: none
		sourceColumn: SubmittersCapped

		annotation SummarizationSetBy = User

	partition ClinVar = m
		mode: import
		source =
				let
				    // Step 2.2 (acquisition): read every part in the folder; QuoteStyle.None because ClinVar text has stray " marks
				    Source = Folder.Files(FolderPath),
				    Parts = Table.SelectRows(Source, each Text.StartsWith([Name], "clinvar_GRCh38_part") and Text.Lower([Extension]) = ".txt"),
				    Parsed = Table.AddColumn(Parts, "Data", each Table.PromoteHeaders(Csv.Document([Content], [Delimiter = "#(tab)", Columns = 43, Encoding = 65001, QuoteStyle = QuoteStyle.None]), [PromoteAllScalars = true])),
				    Combined = Table.Combine(Parsed[Data]),
				    // Step 2.1: keep the 12 columns the analysis needs
				    KeptColumns = Table.SelectColumns(Combined, {"VariationID", "Type", "GeneSymbol", "ClinicalSignificance", "ReviewStatus", "NumberSubmitters", "PhenotypeList", "Assembly", "Chromosome", "Start", "Stop", "LastEvaluated"}),
				    // Step 2.2: confirm genome build, then drop the now-constant column
				    GRCh38Only = Table.SelectRows(KeptColumns, each [Assembly] = "GRCh38"),
				    RemovedAssembly = Table.RemoveColumns(GRCh38Only, {"Assembly"}),
				    // Step 2.4: one row per variant
				    RemovedDuplicates = Table.Distinct(RemovedAssembly, {"VariationID"}),
				    // Step 2.5: hidden missing codes -> real nulls (whole-cell match only)
				    MissingCodes = {"-", "na", "NA", "", "not provided", "not specified", "See cases", "-1"},
				    ReplacedMissingCodes = Table.TransformColumns(RemovedDuplicates, List.Transform(Table.ColumnNames(RemovedDuplicates), (c) => {c, (x) => if List.Contains(MissingCodes, x) then null else x})),
				    // Step 2.6: data types
				    TypedText = Table.TransformColumnTypes(ReplacedMissingCodes, {{"Type", type text}, {"GeneSymbol", type text}, {"ClinicalSignificance", type text}, {"ReviewStatus", type text}, {"PhenotypeList", type text}, {"Chromosome", type text}}),
				    TypedNumbers = Table.TransformColumnTypes(TypedText, {{"VariationID", Int64.Type}, {"NumberSubmitters", Int64.Type}, {"Start", Int64.Type}, {"Stop", Int64.Type}}),
				    NumberErrorsToNull = Table.ReplaceErrorValues(TypedNumbers, {{"VariationID", null}, {"NumberSubmitters", null}, {"Start", null}, {"Stop", null}}),
				    TypedDate = Table.TransformColumns(NumberErrorsToNull, {{"LastEvaluated", each try Date.FromText(_, [Format = "MMM dd, yyyy", Culture = "en-US"]) otherwise null, type date}}),
				    // Step 2.7: flag impossible dates (before 1990) so they can be counted, then blank them
				    FlaggedDates = Table.AddColumn(TypedDate, "DatePlaceholder", each [LastEvaluated] <> null and [LastEvaluated] < #date(1990, 1, 1), type logical),
				    CleanDates = Table.AddColumn(FlaggedDates, "LastEvaluatedClean", each if [DatePlaceholder] then null else [LastEvaluated], type date),
				    SwappedDates = Table.RenameColumns(Table.RemoveColumns(CleanDates, {"LastEvaluated"}), {{"LastEvaluatedClean", "LastEvaluated"}}),
				    // Step 2.8: new columns
				    AddedYear = Table.AddColumn(SwappedDates, "Year", each if [LastEvaluated] = null then null else Date.Year([LastEvaluated]), Int64.Type),
				    AddedGroup = Table.AddColumn(AddedYear, "Group", each
				        let s = Text.Lower([ClinicalSignificance] ?? "") in
				        if s = "" then null
				        else if Text.Contains(s, "conflicting") then "Conflicting"
				        else if Text.Contains(s, "pathogenic") and not Text.Contains(s, "benign") then "P/LP"
				        else if Text.Contains(s, "benign") and not Text.Contains(s, "pathogenic") then "B/LB"
				        else if Text.Contains(s, "uncertain") or Text.StartsWith(s, "vus") then "VUS"
				        else "Other", type text),
				    AddedStars = Table.AddColumn(AddedGroup, "Stars", each
				        let s = Text.Lower([ReviewStatus] ?? "") in
				        if Text.Contains(s, "practice guideline") then 4
				        else if Text.Contains(s, "expert panel") then 3
				        else if Text.Contains(s, "multiple submitters") and Text.Contains(s, "no conflict") then 2
				        else if Text.Contains(s, "criteria provided") then 1
				        else 0, Int64.Type),
				    AddedLength = Table.AddColumn(AddedStars, "Length", each if [Start] = null or [Stop] = null then null else [Stop] - [Start] + 1, Int64.Type),
				    AddedSubmittersCapped = Table.AddColumn(AddedLength, "SubmittersCapped", each if [NumberSubmitters] = null then null else List.Min({[NumberSubmitters], 20}), Int64.Type)
				in
				    AddedSubmittersCapped

	annotation PBI_ResultType = Table

