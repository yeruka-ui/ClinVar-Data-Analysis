table ClinVar
	lineageTag: 2b5730b1-d162-5bd9-a0b0-e6fd5dd5202e

	measure Variants = COUNTROWS(ClinVar)
		formatString: #,0
		displayFolder: Counts
		lineageTag: 335ae0f0-23f9-5ffa-8ac1-681ddf1a4213

	measure 'Labeled Variants' = CALCULATE([Variants], KEEPFILTERS(NOT ISBLANK(ClinVar[Group])))
		formatString: #,0
		displayFolder: Counts
		lineageTag: 96da1e63-3181-5f28-b566-a21e79677d4a

	measure '% of Labeled' = DIVIDE([Variants], CALCULATE([Variants], ALL(ClinVar[Group]), NOT ISBLANK(ClinVar[Group])))
		formatString: 0.0%
		displayFolder: Shares
		lineageTag: c01590e2-5637-551a-872f-7b736a88073b

	measure '% VUS' = DIVIDE(CALCULATE([Variants], ClinVar[Group] = "VUS"), [Labeled Variants])
		formatString: 0.0%
		displayFolder: Shares
		lineageTag: df02d213-8630-5e9f-a313-dc62afd1788d

	measure '% Single Submitter' = DIVIDE(CALCULATE([Variants], ClinVar[NumberSubmitters] = 1), [Variants])
		formatString: 0.0%
		displayFolder: Shares
		lineageTag: d89710ae-6eba-52a3-b965-50be1c363cb8

	measure '% Expert Panel or Guideline' = DIVIDE(CALCULATE([Variants], ClinVar[Stars] >= 3), [Variants])
		formatString: 0.0%
		displayFolder: Shares
		lineageTag: 4d903ed7-3e5b-5c74-8f5a-f0cc9b981feb

	measure '% of Variants' = DIVIDE([Variants], CALCULATE([Variants], ALLSELECTED(ClinVar[Stars])))
		formatString: 0.0%
		displayFolder: Shares
		lineageTag: cefd3e31-821e-5605-bf74-cf8937f673b0

	measure 'Duplicates Removed' = 4639270 - COUNTROWS(ALL(ClinVar))
		formatString: #,0
		displayFolder: Cleaning
		lineageTag: 381bb6e8-4813-51b1-864d-fdcd3d001f1f

	measure 'Date Placeholders Removed' = CALCULATE([Variants], ClinVar[DatePlaceholder] = TRUE())
		formatString: #,0
		displayFolder: Cleaning
		lineageTag: 87e21b97-9b7c-5881-8429-5e5eacd7ee3a

	measure 'Submitters Q1' = PERCENTILE.INC(ClinVar[NumberSubmitters], 0.25)
		formatString: 0.##
		displayFolder: Cleaning
		lineageTag: 4f331423-d473-5bec-8422-cc67e8f4e3ad

	measure 'Submitters Q3' = PERCENTILE.INC(ClinVar[NumberSubmitters], 0.75)
		formatString: 0.##
		displayFolder: Cleaning
		lineageTag: 2e22f278-298f-58c8-a4b7-c55627790db1

	measure 'IQR Fence' = [Submitters Q3] + 1.5 * ([Submitters Q3] - [Submitters Q1])
		formatString: 0.##
		displayFolder: Cleaning
		lineageTag: 5f1fda23-8c42-5ae3-8e6f-6ab16108166f

	measure '% Above Fence' = VAR f = [IQR Fence] RETURN DIVIDE(COUNTROWS(FILTER(ClinVar, ClinVar[NumberSubmitters] > f)), [Variants])
		formatString: 0.0%
		displayFolder: Cleaning
		lineageTag: 8855adc4-f183-5e4f-b8bd-6d282b69508c

	measure 'Length Cut (99.9%)' = PERCENTILE.INC(ClinVar[Length], 0.999)
		formatString: #,0
		displayFolder: Cleaning
		lineageTag: 6e9ca689-9119-5e15-80bf-29c77e8a7fe4

	measure 'Length Outliers' = VAR c = [Length Cut (99.9%)] RETURN COUNTROWS(FILTER(ClinVar, ClinVar[Length] > c))
		formatString: #,0
		displayFolder: Cleaning
		lineageTag: 9982b9a2-2397-5aba-b8c9-c57864d9650a

	measure 'Median Submitters' = MEDIAN(ClinVar[NumberSubmitters])
		formatString: 0.##
		displayFolder: Describe
		lineageTag: eaae6433-89e3-578b-b58d-b321c90d96ea

	measure 'Avg Submitters' = AVERAGE(ClinVar[NumberSubmitters])
		formatString: 0.00
		displayFolder: Describe
		lineageTag: b7ac6fd2-159e-595c-b5de-02415fcf2090

	measure 'Max Submitters' = MAX(ClinVar[NumberSubmitters])
		formatString: #,0
		displayFolder: Describe
		lineageTag: dde3b14b-027d-5326-99b3-9785258eb09c

	measure 'Median Length' = MEDIAN(ClinVar[Length])
		formatString: #,0
		displayFolder: Describe
		lineageTag: 6177c8b3-42f1-533c-bf99-36781f3d680e

	measure 'Max Length' = MAX(ClinVar[Length])
		formatString: #,0
		displayFolder: Describe
		lineageTag: ad48931d-a7da-5f7d-85ea-32358615b837

	measure 'Earliest Review' = MIN(ClinVar[LastEvaluated])
		formatString: yyyy-mm-dd
		displayFolder: Describe
		lineageTag: bec3e68b-32e4-5d42-9eb8-4c5aa0aef152

	measure 'Latest Review' = MAX(ClinVar[LastEvaluated])
		formatString: yyyy-mm-dd
		displayFolder: Describe
		lineageTag: cc422686-02e0-57e1-87b5-d3b871d7f427

	measure 'Variants 2012-2025' = CALCULATE([Variants], KEEPFILTERS(ClinVar[Year] >= 2012 && ClinVar[Year] <= 2025), KEEPFILTERS(ClinVar[Group] IN {"P/LP", "VUS", "B/LB", "Conflicting"}))
		formatString: #,0
		displayFolder: Charts
		lineageTag: 587f076a-1e70-51aa-ad50-3591eb92faa2

	measure 'Labeled Variants (Top 6 Types)' = VAR cur = CALCULATE([Labeled Variants], REMOVEFILTERS(ClinVar[Group])) VAR r = RANKX(ALLSELECTED(ClinVar[Type]), CALCULATE([Labeled Variants], REMOVEFILTERS(ClinVar[Group])), cur, DESC) RETURN IF(r <= 6, [Labeled Variants])
		formatString: #,0
		displayFolder: Charts
		lineageTag: cbf5d6f0-a81b-5d70-b938-cf8a91bec822

