{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "c5_scatter",
  "position": {
    "x": 20,
    "y": 80,
    "z": 4000,
    "width": 615,
    "height": 310,
    "tabOrder": 4000
  },
  "visual": {
    "visualType": "scatterChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Genes"
                    }
                  },
                  "Property": "GeneSymbol"
                }
              },
              "queryRef": "Genes.GeneSymbol",
              "nativeQueryRef": "GeneSymbol",
              "displayName": "Gene"
            }
          ]
        },
        "X": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Genes"
                    }
                  },
                  "Property": "Gene Variants (100+)"
                }
              },
              "queryRef": "Genes.Gene Variants (100+)",
              "nativeQueryRef": "Gene Variants (100+)",
              "displayName": "Variants in gene"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Genes"
                    }
                  },
                  "Property": "Conflict % (100+)"
                }
              },
              "queryRef": "Genes.Conflict % (100+)",
              "nativeQueryRef": "Conflict % (100+)",
              "displayName": "% conflicting"
            }
          ]
        }
      }
    },
    "objects": {
      "categoryAxis": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "showAxisTitle": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "titleText": {
              "expr": {
                "Literal": {
                  "Value": "'Variants in the gene (log scale)'"
                }
              }
            },
            "axisScale": {
              "expr": {
                "Literal": {
                  "Value": "'log'"
                }
              }
            }
          }
        }
      ],
      "valueAxis": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "showAxisTitle": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "titleText": {
              "expr": {
                "Literal": {
                  "Value": "'% of variants with conflicting labels'"
                }
              }
            }
          }
        }
      ],
      "legend": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "position": {
              "expr": {
                "Literal": {
                  "Value": "'Top'"
                }
              }
            }
          }
        }
      ],
      "dataPoint": [
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#5B6C8F'"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Chart 5 - Gene size vs. disagreement between labs (genes with 100+ variants)'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "12D"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
